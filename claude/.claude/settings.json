{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git push:*)"
    ],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "anki-upload@frrad-tools": true,
    "whatsapp-macos-reader@frrad-tools": true
  },
  "effortLevel": "high",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "switchModelsOnFlag": true
}
